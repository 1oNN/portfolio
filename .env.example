# Copy to .env.local for development. Never commit a filled-in copy.
# In production these are set in the Amplify Console; amplify.yml copies the
# runtime-needed ones into .env.production at build time, because Console vars
# exist at build time only and the SSR Lambda does not inherit them.

# Public site origin. Used for canonicals, OG URLs, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin auth. SESSION_SECRET signs the admin cookie and wants 32+ random chars.
# Without SESSION_SECRET the admin area fails closed rather than opening up.
ADMIN_PASSWORD=
SESSION_SECRET=

# Gates the analytics read endpoint. The write path is an unauthenticated
# browser beacon by design. Unset means the read path stays closed.
ANALYTICS_SECRET=

# AWS credentials for SES and DynamoDB.
#
# The APP_ prefix is not a typo and must not be "corrected" to AWS_*. Lambda
# reserves AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY for the execution role and
# refuses them as function environment variables, and it ALWAYS injects
# AWS_REGION with the function's own region, so that name can never be used as
# a fallback. See lib/aws.ts.
#
# Leave these blank to fall back to the default provider chain (profile or SSO),
# which is usually what you want locally.
APP_AWS_REGION=eu-central-1
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=

# SES. SES_FROM_EMAIL must be a verified identity in the region above, or every
# send is rejected on the source. CONTACT_TO_EMAIL is where contact mail lands;
# it falls back to SES_FROM_EMAIL when unset.
SES_FROM_EMAIL=
CONTACT_TO_EMAIL=

# DynamoDB tables. Unset means the feature degrades rather than erroring:
# blog falls back to bundled seed posts, logging is skipped.
DYNAMODB_BLOG_TABLE=
DYNAMODB_CONTACTS_TABLE=
DYNAMODB_AGENT_TABLE=
DYNAMODB_DOWNLOADS_TABLE=

# Groq, for the site agent. Unset makes /api/agent return 503.
GROQ_API_KEY=
